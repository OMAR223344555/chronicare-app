# Chronicare backend - MySQL configuration (copy to .env or export in your shell)
DB_ENGINE=mysql
DB_NAME=chronicare
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# Set DB_ENGINE=sqlite to run without a MySQL server
# DEBUG is off unless this is set to 1 (local development only)
DEBUG=0
# Password reset emails: without these, no reset link is sent or shown
# anywhere, and an admin resets passwords through the Django admin
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
EMAIL_USE_TLS=true
